# Copy this file to `.env` and adjust. `.env` is git-ignored (never commit secrets).

# --- Database (used by both the app and the bundled MySQL container) ---
DB_HOST=db
DB_PORT=3306
DB_NAME=codex
DB_USER=codex
DB_PASS=change-this-db-password

# Root password for the MySQL container (used on first init only)
MYSQL_ROOT_PASSWORD=change-this-root-password

# --- Application ---
# Secret used to sign sessions / tokens. Generate a long random string.
APP_SECRET=change-this-to-a-long-random-string

# Host port the app is published on (http://localhost:APP_PORT)
APP_PORT=8080
